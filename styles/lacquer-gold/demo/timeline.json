 "VO": [
  {
   "id": "v1",
   "t": 0.8,
   "text": "Lacquer begins as tree sap."
  },
  {
   "id": "v2",
   "t": 4.3,
   "text": "A brush lays it on, thin as breath."
  },
  {
   "id": "v3",
   "t": 8.3,
   "text": "Each coat waits for damp air to cure."
  },
  {
   "id": "v4",
   "t": 12.5,
   "text": "Polished smooth, again, thirty times."
  },
  {
   "id": "v5",
   "t": 16.8,
   "text": "Cut one open. Every coat is still there."
  },
  {
   "id": "v6",
   "t": 21.3,
   "text": "Nothing happens. That is the work."
  },
  {
   "id": "v7",
   "t": 25.9,
   "text": "Only now, the gold."
  },
  {
   "id": "v8",
   "t": 29,
   "text": "One line, drawn once. Then powder."
  },
  {
   "id": "v9",
   "t": 33.2,
   "text": "Each stroke rests on every coat beneath."
  },
  {
   "id": "v10",
   "t": 38.4,
   "text": "Turn it, and the light goes deep."
  },
  {
   "id": "v11",
   "t": 45.6,
   "text": "Now, open it."
  },
  {
   "id": "v12",
   "t": 49,
   "text": "Months of waiting, held in one hand."
  }
 ],
