[
 {"id": "v1", "text": "The iris keeps its own hour.", "voice": "af_nicole", "speed": 0.88},
 {"id": "v2", "text": "Winter. Nothing happens, and that is the work.", "voice": "af_nicole", "speed": 0.88},
 {"id": "v3", "text": "Iris is the Greek word for rainbow.", "voice": "af_nicole", "speed": 0.88},
 {"id": "v4", "text": "She watches. She waits.", "voice": "af_nicole", "speed": 0.88},
 {"id": "v5", "text": "Then, in its season, the bud splits.", "voice": "af_nicole", "speed": 0.88},
 {"id": "v6", "text": "And she looks up.", "voice": "af_nicole", "speed": 0.88},
 {"id": "v7", "text": "The iris hour.", "voice": "af_nicole", "speed": 0.85}
]
