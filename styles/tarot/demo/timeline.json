 "VO": [
  {
   "id": "v1",
   "t": 0.9,
   "text": "Someone asks a favour, and your mouth says yes before you do.",
   "asr": "Someone asks a favor and your mouth says yes before you do"
  },
  {
   "id": "v2",
   "t": 6.7,
   "text": "So shuffle. Cut. The deck knows nothing. It only makes you ask three things, in order."
  },
  {
   "id": "v3",
   "t": 14.2,
   "text": "First, the Lantern. What, exactly, is being asked? Say it in a single sentence."
  },
  {
   "id": "v4",
   "t": 24.9,
   "text": "Second, the Key. What does it cost? Count the hours, not the feelings."
  },
  {
   "id": "v5",
   "t": 38.2,
   "text": "Third, the Tide. Will it still matter in a year?"
  },
  {
   "id": "v6",
   "t": 43.1,
   "text": "It lands upside down. Reversed means: not yet."
  },
  {
   "id": "v7",
   "t": 47.85,
   "text": "Any murky card, and the answer waits."
  },
  {
   "id": "v8",
   "t": 52.2,
   "text": "Three questions. One honest answer."
  }
 ]
