wo shades meet, the needle blends them, and there is no edge."},{"t":30.555555555555557,"type":"poke","target":"breast"},{"t":30.833333333333332,"type":"poke","target":"breast"},{"t":31.11111111111111,"type":"poke","target":"breast"},{"t":31.38888888888889,"type":"poke","target":"breast"},{"t":31.666666666666668,"type":"poke","target":"breast"},{"t":31.944444444444446,"type":"poke","target":"breast"},{"t":32.22222222222222,"type":"poke","target":"breast"},{"t":32.5,"type":"poke","target":"breast"},{"t":32.77777777777778,"type":"poke","target":"breast"},{"t":33.05555555555556,"type":"poke","target":"breast"},{"t":33.333333333333336,"type":"poke","target":"breast"},{"t":33.611111111111114,"type":"poke","target":"breast"},{"t":33.88888888888889,"type":"poke","target":"breast"},{"t":34.16666666666667,"type":"poke","target":"breast"},{"t":34.444,"type":"tag"},{"t":34.44444444444445,"type":"poke","target":"breast"},{"t":34.72222222222222,"type":"poke","target":"breast"},{"t":35.56,"type":"wipe"},{"t":36.8,"t1":39,"type":"cap","text":"Last, two small eyes."},{"t":36.9,"type":"voice","id":"v6"},{"t":37.5,"type":"bead"},{"t":37.78,"type":"poke","target":"eyeL"},{"t":38.06,"type":"bead"},{"t":38.33,"type":"poke","target":"eyeR"},{"t":40.56,"type":"blink"},{"t":41.67,"type":"peep"},{"t":42.25,"t1":46.3,"type":"cap","text":"Four thousand pokes. And what was air is looking back."},{"t":42.3,"type":"voice","id":"v7"},{"t":42.5,"type":"tag"},{"t":45.83,"type":"needle_down"},{"t":49.72,"type":"lamp_off"}]}