{"dur":52,"ev":[{"t":0.14,"type":"lamp_on"},{"t":0.5,"t1":3.3,"type":"cap","text":"A handful of wool is mostly air."},{"t":0.55,"type":"voice","id":"v1"},{"t":1.667,"type":"land"},{"t":3.3,"type":"needle_in"},{"t":3.55,"t1":5.85,"type":"cap","text":"A felting needle changes that."},{"t":3.6,"type":"voice","id":"v2"},{"t":3.889,"type":"tag"},{"t":4.166666666666667,"type":"poke","target":"body"},{"t":4.444444444444445,"type":"poke","target":"body"},{"t":4.722222222222222,"type":"poke","target":"body"},{"t":5.833333333333333,"type":"poke","target":"body"},{"t":5.95,"t1":8.78,"type":"cap","text":"Its tiny barbs catch a few fibres on every poke,"},{"t":6.111111111111111,"type":"poke","target":"body"},{"t":6.388888888888889,"type":"poke","target":"body"},{"t":6.666666666666667,"type":"poke","target":"body"},{"t":6.944444444444445,"type":"poke","target":"body"},{"t":7.222222222222222,"type":"poke","target":"body"},{"t":7.5,"type":"poke","target":"body"},{"t":7.777777777777779,"type":"poke","target":"body"},{"t":8.055555555555555,"type":"poke","target":"body"},{"t":8.333333333333334,"type":"poke","target":"body"},{"t":8.611111111111112,"type":"poke","target":"body"},{"t":8.78,"t1":11.9,"type":"cap","text":"and drag them in, where they tangle and stay."},{"t":8.88888888888889,"type":"poke","target":"body"},{"t":9.166666666666668,"type":"poke","target":"body"},{"t":9.444444444444445,"type":"poke","target":"body"},{"t":9.722222222222223,"type":"poke","target":"body"},{"t":10,"type":"poke","target":"body"},{"t":10.277777777777779,"type":"poke","target":"body"},{"t":10.555555555555555,"type":"poke","target":"body"},{"t":10.833333333333334,"type":"poke","target":"body"},{"t":11.11111111111111,"type":"poke","target":"body"},{"t":11.38888888888889,"type":"poke","target":"body"},{"t":11.666666666666668,"type":"poke","target":"body"},{"t":11.944444444444446,"type":"poke","target":"body"},{"t":12.222222222222223,"type":"poke","target":"body"},{"t":13.333,"type":"tag"},{"t":13.45,"t1":