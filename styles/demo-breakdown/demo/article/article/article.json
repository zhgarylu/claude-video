 "sections": [
  {
   "id": "s1",
   "heading": "为什么要数两遍",
   "level": 2,
   "paragraphs": [
    {
     "id": "s1p1",
     "text": "雾湾的浅礁每年要数两遍：一遍靠无人机拍照，一遍靠潜水员沿着固定的线走。"
    },
    {
     "id": "s1p2",
     "text": "两种数法各有盲区：无人机看不见被海藻盖住的珊瑚，潜水员一天只能走完三条线。"
    },
    {
     "id": "s1p3",
     "text": "把两张清单放在一起，一共 91 个点位，只有 30 个两边都数到了，约三分之一。"
    }
   ],
   "figures": [
    "f1"
   ]
  },
  {
   "id": "s2",
   "heading": "一张风险图",
   "level": 2,
   "paragraphs": [
    {
     "id": "s2p1",
     "text": "我们把雾湾分成十二个小区，用颜色标出白化风险：绿色低，黄色中，红色高。"
    },
    {
     "id": "s2p2",
     "text": "红色小区集中在湾口一侧，那里的水流慢、水温高。"
    },
    {
     "id": "s2p3",
     "text": "这张图只是第一版：它用的是去年的数据，今年的潜水线还没有走完。"
    }
   ],
   "figures": [
    "f2"
   ]
  },
  {
   "id": "s3",
   "heading": "带走什么",
   "level": 2,
   "paragraphs": [
    {
     "id": "s3p1",
     "text": "数两遍不是浪费，而是互相校对。看风险图时先问：这一块是两边都数到的，还是只有一边？"
    }
   ],
   "figures": []
  }
 ],
