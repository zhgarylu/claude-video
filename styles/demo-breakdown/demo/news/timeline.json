 "cues": [
  {
   "t0": 0.6,
   "t1": 4.666,
   "text": "岚屿实验室发布了絮语 Mini。官方说"
  },
  {
   "t0": 4.666,
   "t1": 7.829,
   "text": "它能在手机上离线转写会议录音"
  },
  {
   "t0": 7.829,
   "t1": 9.53,
   "text": "下面看官方演示"
  },
  {
   "t0": 10.525,
   "t1": 13.844,
   "text": "演示里选了一段 2 分 40 秒的录音"
  },
  {
   "t0": 13.844,
   "t1": 16.06,
   "text": "点本地转写，文字一行行出来"
  },
  {
   "t0": 18.625,
   "t1": 22.196,
   "text": "飞行模式下标着离线运行，用时 6 秒"
  },
  {
   "t0": 22.196,
   "t1": 25.466,
   "text": "这是官方演示的读数，不是我们测的"
  },
  {
   "t0": 28.442,
   "t1": 32.744,
   "text": "点生成纪要，转写被整理成一条决定和三条待办"
  },
  {
   "t0": 35.75,
   "t1": 39.019,
   "text": "待办都带着原文的时间，可以回头核对"
  },
  {
   "t0": 39.019,
   "t1": 42.0,
   "text": "纪要写得好不好，演示里看不出来"
  },
  {
   "t0": 43.183,
   "t1": 45.959,
   "text": "官方说转写在手机上完成"
  },
  {
   "t0": 45.959,
   "t1": 50.501,
   "text": "我们的理解是：先转文字，再从文字整理纪要"
  },
  {
   "t0": 50.501,
   "t1": 52.892,
   "text": "模型多大，演示里没说"
  },
  {
   "t0": 54.1,
   "t1": 58.633,
   "text": "官方说的是离线运行、6 秒转完。准确率、耗电"
  },
  {
   "t0": 58.633,
   "t1": 61.497,
   "text": "你手机上的速度，要自己验证"
  },
  {
   "t0": 61.497,
   "t1": 65.076,
   "text": "这是官方演示解读，不是我们的实测"
  },
  {
   "t0": 65.076,
   "t1": 68.059,
   "text": "先拿自己的一段录音试一轮"
  }
 ],
