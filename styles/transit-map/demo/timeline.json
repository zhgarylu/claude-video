 "VO": [
  {
   "id": "v1",
   "t": 1.8,
   "text": "This is Halden. Rivers bend, rails curve, and nothing lines up."
  },
  {
   "id": "v2",
   "t": 8,
   "text": "So the map tells a useful lie. It throws away distance, and keeps the connections."
  },
  {
   "id": "v3",
   "t": 15.15,
   "text": "Rule 1. Horizontal, vertical, or 45 degrees. Nothing else."
  },
  {
   "id": "v4",
   "t": 20.05,
   "text": "Rule 2. One line, one colour, one weight."
  },
  {
   "id": "v5",
   "t": 23.3,
   "text": "Rule 3. A tick is a stop. A ring is a change."
  },
  {
   "id": "v6",
   "t": 26.9,
   "text": "Zones tell you what it costs."
  },
  {
   "id": "v7",
   "t": 30.4,
   "text": "You are here, at Quill Lane. The lantern festival is at Rook Point."
  },
  {
   "id": "v8a",
   "t": 35,
   "text": "Fern line, change at Linden."
  },
  {
   "id": "v8b",
   "t": 38.5,
   "text": "Round the Ring, change at Ember Wharf."
  },
  {
   "id": "v8c",
   "t": 42.7,
   "text": "Saffron to the end."
  },
  {
   "id": "v9",
   "t": 46.7,
   "text": "A map doesn't show the city. It shows you the way."
  }
 ],
