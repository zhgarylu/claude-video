# Stills: only the review frames docs point to are committed; everything else in stills/ is a debug frame.
# Name review frames styleframe.jpg, modelsheet*.jpg, frame_*.jpg, alt_*.jpg or engine*.jpg and they are tracked with no extra line here.
styles/*/demo/stills/*
!styles/*/demo/stills/styleframe.jpg
!styles/*/demo/stills/modelsheet*.jpg
!styles/*/demo/stills/frame_*.jpg
!styles/*/demo/stills/alt_*.jpg
!styles/*/demo/stills/engine*.jpg

# 用户自己的片子（agent 输出）
/films/


